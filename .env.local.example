# Clerk (from dashboard / clerk init)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional AI / YouTube
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Supabase Storage (PDF uploads — free plan)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose as NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Optional (default: class-materials). Create public bucket in Storage.
SUPABASE_STORAGE_BUCKET=class-materials

# Cloudflare R2 (Automatic Live Class Video Recording Storage — 10GB free, zero egress)
# Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=curiosphere-recordings
# Public bucket URL (e.g. https://pub-xxxxxxxx.r2.dev or custom domain)
R2_PUBLIC_URL=
